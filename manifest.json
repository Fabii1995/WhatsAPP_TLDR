{
  "manifest_version": 3,
  "name": "WhatsApp TLDR",
  "version": "0.1.0",
  "description": "Adds an optional TLDR button to long WhatsApp Web messages.",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["lib/isLong.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
